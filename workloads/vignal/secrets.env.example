# Copy to secrets.env (git-ignored) and fill in. Never put real values in THIS file (it is tracked).
YOUTUBE_API_KEY=
# R2 S3-compatible credentials; key needs read/write on vignal-public and vignal-private
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Cloudflare token: Zone Cache Purge + Account Analytics Read
CF_API_TOKEN=
# Full ntfy topic URL
NTFY_URL=
# ntfy access token with write access to that topic (server is auth-default-access: deny-all)
NTFY_TOKEN=
# age public key (age1...) used to encrypt backups; keep the private key off-cluster
# success ping URL: Uptime Kuma Push monitor (heartbeat interval 43200s)
HEALTHCHECKS_URL=
AGE_RECIPIENT=
